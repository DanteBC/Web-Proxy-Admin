webproxy ALL=(root) NOPASSWD: /usr/local/sbin/webproxy-routing --status --table 100
webproxy ALL=(root) NOPASSWD: /usr/local/sbin/webproxy-routing --interface awg1 --table 100 --mark 1 --priority 100 --ru-url *
webproxy ALL=(root) NOPASSWD: /usr/local/sbin/webproxy-routing --interface awg1 --table 100 --mark 1 --priority 100 --ru-file *
webproxy ALL=(root) NOPASSWD: /usr/local/sbin/webproxy-routing --interface awg1 --table 100 --mark 1 --priority 100 --direct *
webproxy ALL=(root) NOPASSWD: /usr/local/sbin/webproxy-routing --interface awg1 --table 100 --mark 1 --priority 100 --force-awg *
webproxy ALL=(root) NOPASSWD: /usr/bin/systemctl reload 3proxy.service
webproxy ALL=(root) NOPASSWD: /usr/bin/systemctl is-active 3proxy.service
