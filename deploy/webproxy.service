[Unit]
Description=Web Proxy Administration API
After=network.target network-online.target 3proxy.service
Wants=network-online.target

[Service]
Type=simple
User=webproxy
Group=webproxy
WorkingDirectory=/opt/web-proxy
EnvironmentFile=/etc/web-proxy.env
ExecStart=/opt/web-proxy/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/web-proxy

[Install]
WantedBy=multi-user.target
